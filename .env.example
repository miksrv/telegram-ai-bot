# ============================================================
# TARS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Logging (optional)
# ----------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# ----------------------------------------------------------
# Star charts via starmap-service (optional)
# ----------------------------------------------------------

# Seconds to wait for a finished star chart over MQTT (queued ack + render).
# The service targets ~90–120s on the Raspberry Pi. (default: 120)
STARMAP_MAX_WAIT=120

# Directory the starmap-service writes rendered charts into, shared with the
# bot host. image_path values in starmap results are validated against this
# directory before being read, so a compromised service/broker cannot make the
# bot read arbitrary host files. Leave unset to disable file reads (base64 only).
STARMAP_IMAGE_DIR=/home/mik/starmap-service/output/

# Delete the rendered chart file from STARMAP_IMAGE_DIR after it has been
# successfully sent to Telegram, so charts don't pile up on disk. Only affects
# the file mode (image_path); has no effect on the base64 fallback. (default: false)
STARMAP_DELETE_AFTER_SEND=false

# ----------------------------------------------------------
# LLM Engine
# ----------------------------------------------------------

# Which cloud LLM powers the bot: "groq" or "openai" (default: groq).
# Only the API key for the selected engine is required below; the other
# provider's key may be left blank.
LLM_ENGINE=groq

# Groq API key (https://console.groq.com) — required when LLM_ENGINE=groq
GROQ_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys) — required when LLM_ENGINE=openai
OPENAI_API_KEY=

# Optional per-provider model overrides. Defaults match the table in CLAUDE.md.
# GROQ_MODEL_TEXT=llama-3.3-70b-versatile
# GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_MODEL_TEXT=gpt-4o-mini
# OPENAI_MODEL_VISION=gpt-4o-mini

# ----------------------------------------------------------
# Required
# ----------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# OpenWeatherMap API key (https://openweathermap.org/api)
WEATHER_API_KEY=

# Comma-separated Telegram group chat IDs that TARS is allowed to operate in.
# Use @userinfobot or similar to find your chat ID.
# Example: ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
ALLOWED_CHAT_IDS=

# Comma-separated Telegram user IDs that can interact with the bot in private chat.
# Example: ADMIN_IDS=123456789
ADMIN_IDS=

# ----------------------------------------------------------
# Proactive Engagement (optional)
# ----------------------------------------------------------

# Set to false to disable proactive posting entirely.
PROACTIVE_ENABLED=true

# Comma-separated subset of ALLOWED_CHAT_IDS for which TARS will observe
# messages and post proactively. Leave empty to disable proactive posting
# even if PROACTIVE_ENABLED=true.
# Example: PROACTIVE_CHAT_IDS=-1001234567890
PROACTIVE_CHAT_IDS=

# Maximum proactive posts per chat per calendar day (UTC).
# PROACTIVE_MAX_PER_DAY=5

# Minimum seconds between two consecutive proactive posts (default: 1 hour).
# PROACTIVE_MIN_GAP_SECONDS=3600

# Lower and upper bounds of the random wait window after a post (default: 2–4 hours).
# PROACTIVE_NEXT_MIN_SECONDS=7200
# PROACTIVE_NEXT_MAX_SECONDS=14400

# Number of recent messages passed to the LLM as context.
# PROACTIVE_CONTEXT_MESSAGES=25

# Minimum messages in DB before proactive posting activates for a chat.
# PROACTIVE_MIN_CONTEXT_MESSAGES=10

# Minimum word/character count for a message to be saved to the context DB.
# (OR logic: a message passing either threshold is saved)
# PROACTIVE_MIN_WORD_COUNT=3
# PROACTIVE_MIN_CHAR_COUNT=15

# Once-daily direct reply to one specific past message, in addition to the
# general posts above. Target selection happens in Python/SQL, not the LLM, so
# only one API call (the reply itself) is ever spent on it.
# PROACTIVE_REPLY_ENABLED=true

# Maximum direct replies per chat per calendar day (UTC).
# PROACTIVE_REPLY_MAX_PER_DAY=1

# Minimum word count for a message to qualify as a reply target — deliberately
# higher than PROACTIVE_MIN_WORD_COUNT so a two-word message is never picked.
# PROACTIVE_REPLY_MIN_WORD_COUNT=8

# Random delay window (from UTC midnight) before the daily reply becomes
# eligible to fire, so it doesn't always land right after the day resets
# (default: 1–12 hours).
# PROACTIVE_REPLY_MIN_DELAY_SECONDS=3600
# PROACTIVE_REPLY_MAX_DELAY_SECONDS=43200

# How long a message is retained in the DB (default: 24 hours).
# MESSAGE_TTL_SECONDS=86400

# Cleanup daemon wake interval (default: 30 minutes).
# CLEANUP_LOOP_INTERVAL_SECONDS=1800

# Proactive posting daemon wake interval (default: 10 minutes).
# PROACTIVE_LOOP_INTERVAL_SECONDS=600
