# ============================================================
# TARS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Logging (optional)
# ----------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# ----------------------------------------------------------
# Star charts via starmap-service (optional)
# ----------------------------------------------------------

# Seconds to wait for a finished star chart over MQTT (queued ack + render).
# The service targets ~90–120s on the Raspberry Pi. (default: 120)
# STARMAP_MAX_WAIT=120

# ----------------------------------------------------------
# Required
# ----------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# Groq API key (https://console.groq.com)
GROQ_API_KEY=

# OpenWeatherMap API key (https://openweathermap.org/api)
WEATHER_API_KEY=

# Comma-separated Telegram group chat IDs that TARS is allowed to operate in.
# Use @userinfobot or similar to find your chat ID.
# Example: ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
ALLOWED_CHAT_IDS=

# Comma-separated Telegram user IDs that can interact with the bot in private chat.
# Example: ADMIN_IDS=123456789
ADMIN_IDS=

# ----------------------------------------------------------
# Proactive Engagement (optional)
# ----------------------------------------------------------

# Set to false to disable proactive posting entirely.
PROACTIVE_ENABLED=true

# Comma-separated subset of ALLOWED_CHAT_IDS for which TARS will observe
# messages and post proactively. Leave empty to disable proactive posting
# even if PROACTIVE_ENABLED=true.
# Example: PROACTIVE_CHAT_IDS=-1001234567890
PROACTIVE_CHAT_IDS=

# Maximum proactive posts per chat per calendar day (UTC).
# PROACTIVE_MAX_PER_DAY=5

# Minimum seconds between two consecutive proactive posts (default: 1 hour).
# PROACTIVE_MIN_GAP_SECONDS=3600

# Lower and upper bounds of the random wait window after a post (default: 2–4 hours).
# PROACTIVE_NEXT_MIN_SECONDS=7200
# PROACTIVE_NEXT_MAX_SECONDS=14400

# Number of recent messages passed to the LLM as context.
# PROACTIVE_CONTEXT_MESSAGES=25

# Minimum messages in DB before proactive posting activates for a chat.
# PROACTIVE_MIN_CONTEXT_MESSAGES=10

# Minimum word/character count for a message to be saved to the context DB.
# (OR logic: a message passing either threshold is saved)
# PROACTIVE_MIN_WORD_COUNT=3
# PROACTIVE_MIN_CHAR_COUNT=15

# How long a message is retained in the DB (default: 24 hours).
# MESSAGE_TTL_SECONDS=86400

# Cleanup daemon wake interval (default: 30 minutes).
# CLEANUP_LOOP_INTERVAL_SECONDS=1800

# Proactive posting daemon wake interval (default: 10 minutes).
# PROACTIVE_LOOP_INTERVAL_SECONDS=600
